{
  "1": {
    "class_type": "Krea2SVDQuantLoader",
    "_meta": {"title": "Krea2 SVDQuant Loader"},
    "inputs": {
      "svdquant_model": "transformer_svdquant.safetensors",
      "base_model": "krea2_svdquant_base_parts.safetensors",
      "backend": "tensorcore"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {"title": "Text encoder (Qwen3-VL 4B)"},
    "inputs": {"clip_name": "qwen3vl_4b_fp8_scaled.safetensors", "type": "krea2", "device": "default"}
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {"title": "VAE"},
    "inputs": {"vae_name": "qwen_image_vae.safetensors"}
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Prompt"},
    "inputs": {
      "text": "A photorealistic portrait of a snow leopard resting on a mossy rock in a misty alpine forest at dawn, golden rim light, shallow depth of field, 85mm lens, ultra detailed fur",
      "clip": ["2", 0]
    }
  },
  "5": {
    "class_type": "ConditioningZeroOut",
    "_meta": {"title": "Negative (zeroed, cfg=1)"},
    "inputs": {"conditioning": ["4", 0]}
  },
  "6": {
    "class_type": "EmptySD3LatentImage",
    "_meta": {"title": "Latent 1024x1024 (16ch)"},
    "inputs": {"width": 1024, "height": 1024, "batch_size": 1}
  },
  "7": {
    "class_type": "KSampler",
    "_meta": {"title": "KSampler (turbo: 8 steps, cfg 1)"},
    "inputs": {
      "seed": 987654321, "steps": 8, "cfg": 1.0, "sampler_name": "euler",
      "scheduler": "simple", "denoise": 1.0,
      "model": ["1", 0], "positive": ["4", 0], "negative": ["5", 0], "latent_image": ["6", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": {"title": "VAE Decode"},
    "inputs": {"samples": ["7", 0], "vae": ["3", 0]}
  },
  "9": {
    "class_type": "SaveImage",
    "_meta": {"title": "Save"},
    "inputs": {"images": ["8", 0], "filename_prefix": "krea2_svdquant"}
  }
}
